PLANE_API_URL=https://api.plane.so
PLANE_API_KEY=your_api_key_here
PLANE_WORKSPACE_SLUG=your_workspace_slug

DATABASE_URL=postgresql://db_user:db_password@host.docker.internal:5432/personal_task_manager

PORT=3000

# 32 bytes en hex (genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your_32_byte_hex_key_here

DOCUMENTS_PATH=/documents

# PDF export (requiere Python 3 + reportlab instalado)
# Por defecto usa scripts/markdown2pdf/garagelabs-template/md2pdf_garagelabs.py
# PDF_SCRIPT=/ruta/alternativa/md2pdf_garagelabs.py
